  m_Script: {fileID: 11500000, guid: dadef4f80be1be646aa271ba4dfbb324, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textElement: {fileID: 1630705744}
  charDelay: 0.05
  allowSkip: 1
  playOnStart: 1
  linesToPlayOnStart:
  - Welcome, welcome
  - so what's up with all this
  - So, This is for my final assignment, where I tried to see if this game can train
    problem solving.
  - at least it is in line with what was written
  - so just go straight to it
  - do you know nanogram?
  - something like that, with some additional mechanisms
  - but first there will be a pre-test, then "play", and finally the post-test
  - in the test there will be a score and time, apart from that please go crazy
  - Don't go too crazy, but the main goal is whether you can complete the post better
    than the pre-test.
  - THe test will have a timer and score for every reset or wrong answer, keep that
    in mind
  - You might not see the timer or the score, but its there. Whenever you ready just
    press the button
  OnDialogueComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 761194185}
        m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
        m_MethodName: SetActive
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
